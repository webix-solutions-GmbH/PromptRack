# Postgres connection for the app, the migration runner and the seed script.
DATABASE_URL=postgres://agentval:dev@127.0.0.1:5433/agentval

# Production compose only: the password the bundled postgres service is created with.
POSTGRES_PASSWORD=change-me

# Max size of the app's Postgres connection pool. Must exceed the number of runs
# that can execute concurrently plus normal request concurrency — an executing
# run holds one connection for its whole duration. Default: 10.
# DATABASE_POOL_MAX=10

# Project root scripts/init-db.mjs resolves drizzle/ from. Defaults to the cwd;
# only needed if you run the bootstrap script from somewhere else.
# APP_ROOT=.

# --- Auth -------------------------------------------------------------------
# 32+ random bytes: `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-me
# Public origin. The app serves at the root; if a basePath is configured in
# src/lib/base-path.ts, include it here too.
BETTER_AUTH_URL=http://localhost:3000

# Optional generic OIDC provider (Entra ID / Keycloak / Authentik / ...).
# Leave OIDC_ISSUER empty to disable the "Sign in with SSO" button entirely.
# Redirect URI to register with the IdP:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid,profile,email
OIDC_BUTTON_LABEL=Single sign-on
# Role given to auto-provisioned OIDC users: admin | member | viewer
OIDC_DEFAULT_ROLE=member

# --- Seeding ----------------------------------------------------------------
# Which customer workspace `npm run db:seed` fills, by name or id. Unset seeds
# the oldest workspace, which on every existing install is "Default". A value
# that matches no workspace (or several) exits non-zero and lists them — it never
# creates one, so a typo cannot produce a near-duplicate workspace.
SEED_CUSTOMER=

# Set to "true" to expose /api/mock-llm and /api/mock-mcp in a production build.
ENABLE_MOCKS=
