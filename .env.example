# Postgres connection for the backend and the migration runner (alembic).
# docker/compose.dev.yml serves exactly this on 127.0.0.1:5433; point it at a
# managed database instead by changing this value.
DATABASE_URL=postgres://promptrack:dev@127.0.0.1:5433/promptrack

# Max size of the backend's async Postgres connection pool. Must exceed the
# number of runs that can execute concurrently plus normal request
# concurrency — an executing run holds one connection for its whole
# duration. Default: 10.
# DATABASE_POOL_MAX=10

# OIDC single sign-on (optional). Unset OIDC_ISSUER means no SSO at all: the
# app runs on email/password only, and mounts no /api/auth/oidc/* routes.
# OIDC_ISSUER=https://login.example.com/realms/webix
# OIDC_CLIENT_ID=promptrack
# OIDC_CLIENT_SECRET=
# Comma-separated. Default: openid,profile,email
# OIDC_SCOPES=openid,profile,email
# The role a *new* OIDC-provisioned account gets (admin/member/viewer).
# Unrecognised values fall back to viewer, never admin. Default: member
# OIDC_DEFAULT_ROLE=member

# Signs the short-lived cookie Authlib uses to carry OIDC's state/nonce across
# the redirect to the identity provider and back. Random per process start if
# unset — pin it in a multi-process deployment so a callback landing on a
# different worker than the redirect still verifies.
# SESSION_SECRET=

# "development" (default) or "production". Governs only whether the mock LLM
# / mock MCP routes (/api/mock-llm/*, /api/mock-mcp) answer or 404 — baked in
# as "production" at build time by docker/Dockerfile.
# ENVIRONMENT=development

# Forces the mock routes on even when ENVIRONMENT=production. Off by default
# so a production image never accidentally exposes a fake OpenAI endpoint.
# ENABLE_MOCKS=false

# --- Deployment (docker/compose.yml) --------------------------------------

# Password for the bundled Postgres service. Required — docker/compose.yml
# refuses to start without it (no default).
# POSTGRES_PASSWORD=

# Which published image tag docker/compose.yml runs. Defaults to "main"; set to
# a version to pin a deployment to a specific release instead of tracking the
# branch, which is what makes `docker compose pull` a deliberate upgrade.
# Note the missing "v": the git tag is `v0.3.0`, but the workflow's
# `type=semver,pattern={{version}}` publishes the image as `0.3.0`, so a
# `PROMPTRACK_TAG=v0.3.0` would fail to pull. `0.3` tracks the latest patch of
# that minor, and `latest` the newest release.
# PROMPTRACK_TAG=0.3.0
