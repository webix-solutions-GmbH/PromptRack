# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local, unpublished agent notes
CLAUDE.local.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database
/data/

# A local SQLite database export, never committed: it holds a live API key
# for a real endpoint.
docs/app.db
docs/app.db-shm
docs/app.db-wal

docs/notes.md
docs/superpowers/

__pycache__/
*.pyc

# Playwright MCP session artifacts (snapshots, console logs)
.playwright-mcp/
